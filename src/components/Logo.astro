---
// Brand lockup: official Kesoniti icon mark + typeset wordmark.
//
// public/logo-icon.png is the real logo artwork (the three-arc "K" mark),
// cropped from the full lockup and with its white background removed so it
// sits cleanly on both light and dark sections. Source aspect ratio is
// 765:675 — width is derived from `size` (the rendered height) to avoid
// distorting it.
const ICON_ASPECT = 765 / 675;

interface Props {
  /** Rendered height of the mark in px. Width is derived to preserve aspect ratio. */
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
const width = Math.round(size * ICON_ASPECT);
---

<span class:list={['logo', className]}>
  <img
    class="logo-mark"
    src="/logo-icon.png"
    alt=""
    width={width}
    height={size}
    style={`height: ${size}px; width: ${width}px;`}
  />
  <span class="logo-word">KESONITI</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo-mark { flex: none; }
  .logo-word {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.16em;
    line-height: 1;
  }
</style>
