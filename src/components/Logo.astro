---
// Brand lockup: rotational tri-arc mark + wordmark.
//
// The mark is a simplified, web-optimised interpretation of the Kesoniti
// logo — three arcs rotating around a common centre in the brand's teal,
// navy and silver. To use the official artwork instead, drop it in at
// `public/logo.svg` and swap the <svg> below for:
//   <img src="/logo.svg" alt="" width="34" height="34" />
interface Props {
  /** Size of the mark in px. */
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg
    class="logo-mark"
    width={size}
    height={size}
    viewBox="0 0 100 100"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    <g fill="none" stroke-width="11" stroke-linecap="round">
      <path d="M16.5,55.9 A34,34 0 0 1 67,20.6" stroke="#35bfc4" />
      <path d="M16.5,55.9 A34,34 0 0 1 67,20.6" stroke="#1b4a78" transform="rotate(120 50 50)" />
      <path d="M16.5,55.9 A34,34 0 0 1 67,20.6" stroke="#aab6bf" transform="rotate(240 50 50)" />
    </g>
  </svg>
  <span class="logo-word">KESONITI</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo-mark { flex: none; }
  .logo-word {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.16em;
    line-height: 1;
  }
</style>
